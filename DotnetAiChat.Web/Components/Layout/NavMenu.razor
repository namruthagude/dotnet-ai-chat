@rendermode InteractiveServer
@using DotnetAiChat.Core.Data
@using DotnetAiChat.Core.Models
@using Microsoft.EntityFrameworkCore
@inject ChatDbContext Db
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">DotnetAiChat.Web</a>
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <button class="nav-link btn btn-link" @onclick="StartNewConversation">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> New Conversation
            </button>
        </div>

        @foreach (var convo in conversations)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@($"chat/{convo.Id}")">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @convo.Title
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private List<Conversation> conversations = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadConversations();
    }

    private async Task LoadConversations()
    {
        conversations = await Db.conversations
            .OrderByDescending(c => c.UpdatedAt)
            .ToListAsync();
    }

    private async Task StartNewConversation()
    {
        var newConvo = new Conversation { Title = "New Chat" };
        Db.conversations.Add(newConvo);
        await Db.SaveChangesAsync();
        await LoadConversations();
        Nav.NavigateTo($"/chat/{newConvo.Id}", forceLoad: true);
    }
}